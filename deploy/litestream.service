[Unit]
Description=Litestream SQLite replication (obi)
After=network-online.target obi.service
Wants=network-online.target

[Service]
Type=simple
User=obi
ExecStart=/usr/local/bin/litestream replicate -config /opt/obi/litestream.yml
Restart=on-failure
RestartSec=10
EnvironmentFile=/opt/obi/litestream.env
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/obi/data

[Install]
WantedBy=multi-user.target
