[Unit]
Description=Check Obi official patch releases every 15 minutes

[Timer]
# 每 15 分钟检查一次（错开整点，避免多台实例同时请求）；开机后 2 分钟补查一次。
# 补丁发布后通常 15 分钟内装上；GitHub 未登录接口每小时 60 次，这里每小时 4 次。
OnCalendar=*:0/15
RandomizedDelaySec=120
OnBootSec=120s
Persistent=true
AccuracySec=1min
Unit=obi-update.service

[Install]
WantedBy=timers.target
