server {
    listen 80;
    server_name albums.your.domain;
    location ^~ /.well-known/acme-challenge/ { root /var/www/album-ledger-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name albums.your.domain;
    ssl_certificate /etc/letsencrypt/live/albums.your.domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/albums.your.domain/privkey.pem;
    client_max_body_size 50m;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
}
