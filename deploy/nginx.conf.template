# Obi · Nginx 反代模板（HTTPS + ACME 续期）
# 使用前把 your.domain 全部替换为你的域名；证书路径随 certbot lineage 自动对应。
server {
    listen 80;
    server_name your.domain;
    location ^~ /.well-known/acme-challenge/ { root /var/www/obi-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name your.domain;
    ssl_certificate /etc/letsencrypt/live/your.domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your.domain/privkey.pem;
    client_max_body_size 50m;
    # 应用自身已按 Accept-Encoding gzip；这里只作兜底（如旧版本未压缩的响应）
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    # 完整备份包（zip，含照片，可达数 GB）：恢复上传放宽体积、不在 nginx 落盘缓冲；下载生成可能较慢
    location = /api/restore-archive {
        client_max_body_size 4g;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
    location = /api/backup {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 900s;
    }
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
}
