---
// 四条承诺：来自 AGENTS.md 红线与界面原则，对外用一句话表达。图标 + 短句，不展开解释。
const items = [
  { t: '数据只在你的设备上', d: '单用户 SQLite，可完整备份恢复',
    icon: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>' },
  { t: '分毫不差', d: '日元原价、运费、手续费，按当天汇率折算',
    icon: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/>' },
  { t: '条码精确匹配', d: '多个候选由你选，不按标题猜',
    icon: '<path d="M4 6v12M7 6v12M10 6v12M14 6v12M16 6v12M20 6v12"/>' },
  { t: '手机优先', d: '可装到主屏幕，也能离线用',
    icon: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>' },
];
---
<section class="section">
  <div class="wrap">
    <ul class="list">
      {items.map((i) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={i.icon} />
          <div><h3>{i.t}</h3><p>{i.d}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* 四条承诺：手机单列，其余 2×2，不出现 3+1；整块限宽居中，不贴左右两边 */
  .list{ display:grid; grid-template-columns:1fr; gap:var(--s-5) var(--s-7); max-width:44rem; margin:0 auto; padding:0; list-style:none; }
  @media (min-width:40rem){ .list{ grid-template-columns:repeat(2,max-content); justify-content:center; } }
  li{ display:flex; gap:var(--s-3); align-items:flex-start; }
  svg{ flex:none; width:1.75rem; height:1.75rem; fill:none; stroke:var(--text); stroke-width:1.75; stroke-linecap:round; stroke-linejoin:round; }
  h3{ font-size:var(--fs-md); }
  p{ margin-top:var(--s-1); color:var(--muted); font-size:var(--fs-sm); }
</style>
