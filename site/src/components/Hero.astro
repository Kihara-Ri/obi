---
// 首屏：标语 + 三个入口 + 右侧「被腰封包着的封面墙」。
// 腰封（帯，obi）是日版 CD 侧面那条竖纸条，也是项目名的来历：竖排文字压在封面墙左缘。
// 封面墙三列缓慢匀速漂移（中列反向），减少动态效果时静止。
// 封面都是真实专辑的像素图：改 site/cover-wall.json 后运行 scripts/pixel-covers.py 生成（D-044），按清单顺序轮流分到三列。
import CoverColumn from './CoverColumn.astro';
import wall from '../covers.json';
const repo = 'https://github.com/Kihara-Ri/obi';
const cols = [0, 1, 2].map((i) => wall.covers.filter((_, n) => n % 3 === i).map((c) => c.file));
---
<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="kicker">专辑收藏与交易账本</p>
      <h1>收藏有来处，<br />流转有记录。</h1>
      <ul class="facts" aria-label="特点">
        {['开源', '自托管', '数据只在你的设备上'].map((f) => (
          <li>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m3.5 8.5 3 3 6-7" /></svg>
            {f}
          </li>
        ))}
      </ul>
      <div class="cta">
        <a class="btn primary" href="#start">开始使用</a>
        <a class="btn" href={`${repo}/releases/latest`}>
          <!-- 安卓机器人头像（自绘）：半圆头 + 两根天线，眼睛用 evenodd 镂空 -->
          <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d="M2.5 18.5a9.5 9.5 0 0 1 19 0zM8 13.4a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zm8 0a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z" />
            <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M7.2 10.6 5.4 7.4M16.8 10.6l1.8-3.2" />
          </svg>
          下载安卓版
        </a>
      </div>
    </div>

    <div class="case" aria-hidden="true">
      <div class="wall">
        {cols.map((c, i) => <CoverColumn covers={c} size={wall.size} reverse={i === 1} />)}
      </div>
      <div class="obi"><span class="obi-big">Obi</span><span class="obi-small">收藏 · 记录 · 展示 · 交易</span></div>
    </div>
  </div>
</section>

<style>
  .hero{ padding-block:var(--s-7) var(--s-8); overflow:clip; }
  .grid{ display:grid; gap:var(--s-7); align-items:center; }
  .kicker{ color:var(--accent-deep); font-weight:700; font-size:var(--fs-sm); letter-spacing:.08em; }
  h1{ margin-top:var(--s-3); font-size:var(--fs-hero); font-weight:800; letter-spacing:-.02em; }
  /* 特点是陈述不是按钮：不加边框和底色，前面一个打勾，避免看起来能点 */
  .facts{ display:flex; flex-wrap:wrap; gap:var(--s-2) var(--s-5); margin:var(--s-5) 0 0; padding:0; list-style:none; }
  .facts li{ display:flex; align-items:center; gap:var(--s-1); color:var(--muted); font-size:var(--fs-sm); }
  .facts svg{ flex:none; color:var(--accent-deep); }
  .cta{ display:flex; flex-wrap:wrap; gap:var(--s-3); margin-top:var(--s-6); }
  .btn{
    display:inline-flex; align-items:center; gap:var(--s-2); min-height:2.75rem; padding-inline:var(--s-5);
    border-radius:999px; border:1px solid var(--border-strong); background:var(--surface);
    font-weight:600; transition:background var(--dur-fast) var(--ease-soft), transform var(--dur-fast) var(--ease-soft);
  }
  .btn.primary{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .btn:active{ transform:scale(.97); }
  @media (hover:hover){
    .btn:hover{ background:var(--surface-2); }
    .btn.primary:hover{ background:var(--accent-strong); }
  }

  .case{
    /* 标准 CD 盒 142×125mm：横向略长 */
    position:relative; aspect-ratio:142 / 125; border-radius:var(--radius);
    background:var(--surface-3); box-shadow:var(--shadow); overflow:hidden;
  }
  .wall{
    position:absolute; inset:0 0 0 var(--obi-w);
    display:grid; grid-template-columns:repeat(3,1fr); gap:var(--s-3); padding-inline:var(--s-3);
    mask-image:linear-gradient(to bottom, transparent, black 12%, black 88%, transparent);
  }
  .obi{
    position:absolute; inset:0 auto 0 0; width:calc(var(--obi-w) + var(--s-2));
    /* 竖排（vertical-rl）下 row 才是竖直方向，inline 方向的内边距才是上下：大字在上、小字在下，两头都留白 */
    display:flex; flex-direction:row; align-items:center; justify-content:space-between; padding-inline:var(--s-5);
    background:var(--accent); color:var(--accent-ink); writing-mode:vertical-rl; white-space:nowrap;
    box-shadow:var(--shadow-sm);
  }
  .obi-big{ font-weight:900; font-size:var(--fs-xl); letter-spacing:.12em; line-height:1; }
  .obi-small{ font-size:var(--fs-xs); font-weight:600; letter-spacing:.3em; opacity:.8; }

  @media (min-width:56rem){
    .hero{ padding-block:var(--s-8) var(--s-9); }
    .grid{ grid-template-columns:1.1fr 1fr; }
  }
</style>
