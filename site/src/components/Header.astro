---
// 页眉：标志 + 锚点导航 + GitHub。吸顶半透明，与应用顶栏同一套 chrome token。
// 「接口」是独立页面（给外部 Agent 的接口说明），前面加一个代码括号图标，和三个页内锚点区分开。
// 在「接口」页上它标为当前页（aria-current）。
// 手机上只留标志和 GitHub，锚点导航收起（少字原则）。其他页面（如「接口」）上锚点带首页前缀。
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = Astro.url.pathname.replace(/\/?$/, '/') === base ? '' : base;
const repo = 'https://github.com/Kihara-Ri/obi';
const onApi = Astro.url.pathname.replace(/\/?$/, '/') === `${base}api/`;
---
<header class="head">
  <div class="wrap row">
    <a class="brand" href={base} aria-label="Obi 首页">
      <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
      <span>Obi</span>
    </a>
    <nav class="nav" aria-label="页面导航">
      <a href={`${home}#features`}>功能</a>
      <a href={`${home}#gallery`}>展示</a>
      <a href={`${home}#start`}>开始使用</a>
      <a class="api" href={`${base}api/`} aria-current={onApi ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 5l-3 14" /></svg>接口
      </a>
    </nav>
    <a class="gh" href={repo} aria-label="GitHub 仓库">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  </div>
</header>

<style>
  .head{
    position:sticky; top:0; z-index:10;
    padding-top:env(safe-area-inset-top);
    background:var(--chrome-head); border-bottom:1px solid var(--chrome-line);
    backdrop-filter:saturate(1.6) blur(16px); -webkit-backdrop-filter:saturate(1.6) blur(16px);
  }
  .row{ display:flex; align-items:center; gap:var(--s-5); min-height:3.5rem; }
  .brand{ display:flex; align-items:center; gap:var(--s-2); font-weight:800; font-size:var(--fs-lg); letter-spacing:.02em; }
  .brand img{ border-radius:var(--radius-sm); }
  .nav{ display:none; gap:var(--s-5); margin-left:auto; font-size:var(--fs-sm); color:var(--muted); }
  .nav a{ padding-block:var(--s-2); transition:color var(--dur-fast) var(--ease-soft); }
  .nav .api{ display:inline-flex; align-items:center; gap:var(--s-1); }
  .nav [aria-current='page']{ color:var(--text); font-weight:600; }
  .api svg{ fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .gh{ display:grid; place-items:center; width:2.75rem; height:2.75rem; margin-left:auto; border-radius:50%; color:var(--muted); transition:color var(--dur-fast) var(--ease-soft), background var(--dur-fast) var(--ease-soft); }
  @media (hover:hover){
    .nav a:hover, .gh:hover{ color:var(--text); }
    .gh:hover{ background:var(--surface-2); }
  }
  @media (min-width:40rem){
    .nav{ display:flex; }
    .gh{ margin-left:0; }
  }
</style>
