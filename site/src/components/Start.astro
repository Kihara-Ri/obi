---
// 开始使用：四条路径（Docker / 裸 Python / 让 AI Agent 装 / 手机本地使用），2×2 排列。Agent 提示词引导它读 README 与部署说明。命令与 README「快速开始」保持一致，改一处要同步另一处。
// 复制按钮由 scripts/copy.ts（外链 ES module）接管；没有 JS 时命令仍可手动选中复制。
const repo = 'https://github.com/Kihara-Ri/obi';
const prompt = `请帮我在这台机器上安装 Obi（${repo}）。
先读仓库里的 README.md 和 部署说明.md：有 Docker 就按「方案一」用 docker compose 启动，没有就用 python3 app.py。
装好后确认 http://127.0.0.1:8765 能打开，告诉我数据存在哪个目录、怎么停止和更新。`;
const paths = [
  { name: 'Docker', tag: '推荐', cmd: `git clone ${repo}\ncd obi\ncp .env.example .env\ndocker compose up -d --build`, note: '打开 127.0.0.1:8765，数据在 ./data' },
  { name: 'Python', cmd: `git clone ${repo}\ncd obi\npython3 app.py`, note: '零依赖，Python 3.10+' },
  { name: '让 AI Agent 装', cmd: prompt, prose: true, note: '复制给 Claude Code、Codex 等能运行命令的 Agent' },
  { name: '手机本地使用', links: [{ t: '下载安卓 APK', href: `${repo}/releases/latest` }, { t: '本机模式说明', href: `${repo}/blob/main/部署说明.md#方案三没有服务器本机模式主要给手机` }], note: '数据只存在手机里，不用服务器，可断网使用' },
];
---
<section id="start" class="section band">
  <div class="wrap">
    <h2 class="section-title">开始使用</h2>
    <p class="section-sub">公网部署、登录与异地备份见<a class="link" href={`${repo}/blob/main/部署说明.md`}>部署说明</a>。</p>
    <ol class="paths">
      {paths.map((p) => (
        <li class="path">
          <div class="head">
            <h3>{p.name}</h3>{p.tag && <span class="tag">{p.tag}</span>}
            {p.cmd && <button type="button" class="copy" data-copy={p.cmd} aria-label={`复制 ${p.name} ${p.prose ? '提示词' : '命令'}`}>复制</button>}
          </div>
          {p.cmd && <pre class:list={{ prose: p.prose }}><code>{p.cmd}</code></pre>}
          {p.links && <div class="links">{p.links.map((l) => <a class="btn" href={l.href}>{l.t}</a>)}</div>}
          <p class="note">{p.note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script src="../scripts/copy.ts"></script>

<style>
  .band{ background:var(--surface-2); }
  .link{ color:var(--text); text-decoration:underline; text-decoration-color:var(--accent-deep); text-underline-offset:.2em; margin-left:var(--s-1); }
  /* 四条路径：手机单列，其余 2×2 */
  .paths{ display:grid; grid-template-columns:1fr; gap:var(--s-4); margin:var(--s-6) 0 0; padding:0; list-style:none; }
  @media (min-width:40rem){ .paths{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
  .path{ display:flex; flex-direction:column; gap:var(--s-3); padding:var(--s-5); border-radius:var(--radius); background:var(--surface); border:1px solid var(--border); min-width:0; }
  .head{ display:flex; align-items:center; gap:var(--s-2); }
  h3{ font-size:var(--fs-lg); }
  .tag{ font-size:var(--fs-xs); font-weight:600; padding:0 var(--s-2); border-radius:999px; background:var(--accent); color:var(--accent-ink); }
  pre{ margin:0; padding:var(--s-4); overflow-x:auto; border-radius:var(--radius-sm); background:var(--surface-2); border:1px solid var(--hairline); font-size:var(--fs-xs); line-height:1.7; }
  /* 提示词是自然语言：自动换行，用正文字体 */
  pre.prose{ white-space:pre-wrap; font-family:inherit; line-height:1.8; }
  .copy{ margin-left:auto; min-height:2.25rem; padding-inline:var(--s-3); border:1px solid var(--border); border-radius:999px; background:var(--surface); font-size:var(--fs-xs); cursor:pointer; }
  .copy[data-done]{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .links{ display:flex; flex-wrap:wrap; gap:var(--s-2); }
  .btn{ display:inline-flex; align-items:center; min-height:2.75rem; padding-inline:var(--s-4); border-radius:999px; border:1px solid var(--border-strong); font-weight:600; font-size:var(--fs-sm); }
  .note{ margin-top:auto; color:var(--muted); font-size:var(--fs-sm); }
  /* 已复制的高亮优先于悬停，否则鼠标还停在按钮上时会被悬停底色盖掉，深色下成了黑底黑字 */
  @media (hover:hover){ .btn:hover, .copy:not([data-done]):hover{ background:var(--surface-2); } }
</style>
