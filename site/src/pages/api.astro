---
// 「接口」页：服务器版的完整接口参考，像一张唱片分两面。
// A 面给 Agent：MCP 接入、权限、按场景分组的工具、场景模板、协议细节（lib/api-mcp.ts）。
// B 面给脚本与自动化：HTTP 鉴权与调用、对外接口（lib/api-http.ts）、应用内部接口按功能分组（lib/api-app.ts）。
// 左侧汇总栏 ApiToc 两面分开；数据与 server/routes.py、server/mcp_tools.py 逐项对应，改动时同步 docs/HTTP接口一览.md 与 docs/MCP接入.md。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ApiToc from '../components/ApiToc.astro';
import ApiTool from '../components/ApiTool.astro';
import ApiGroup from '../components/ApiGroup.astro';
import { scopes, issue, clients, toolGroups, prompts, protocol } from '../lib/api-mcp';
import { curl, login, conventions, errors, open } from '../lib/api-http';
import { app } from '../lib/api-app';
const docs = 'https://github.com/Kihara-Ri/obi/blob/main/docs';
// 同一路由在多个分组出现（如 /api/bulk）或按参数分两行（资料包）时只算一次
const total = new Set([open, ...app].flatMap((g) => g.routes.map((r) => `${r.m} ${r.p.split('?')[0]}`))).size;
const tools = toolGroups.reduce((n, g) => n + g.tools.length, 0);
---
<Base title="接口 · Obi" description="Obi 服务器版的完整接口参考：A 面是给 Agent 的 MCP 工具与场景模板，B 面是全部 HTTP 路由，含鉴权方式、参数与返回。">
  <Header />
  <main class="wrap">
    <header class="intro">
      <h1>接口</h1>
      <p class="lede">一张唱片，两面。A 面给 Agent，连上 MCP 就能用；B 面是同一套能力的 HTTP 路由，给脚本和自动化。</p>
      <p class="sides">
        <a href="#side-a"><span class="mark" aria-hidden="true">A</span>MCP · {tools} 个工具</a>
        <a href="#side-b"><span class="mark" aria-hidden="true">B</span>HTTP · {total} 条路由</a>
      </p>
    </header>

    <div class="layout">
      <ApiToc />
      <div class="content">
        <section id="side-a" class="side" aria-labelledby="side-a-t">
          <header class="sh"><span class="disc" aria-hidden="true">A</span><div><h2 id="side-a-t">Agent · MCP</h2><p>Claude Code、Cursor 等客户端填上地址和令牌，只看得到令牌权限内的工具。</p></div></header>

          <section id="mcp-connect" class="block" aria-labelledby="mcp-connect-t">
            <h3 id="mcp-connect-t">接入与权限</h3>
            <ol class="steps">
              <li>
                <p><b>签发令牌</b>　在「设置 → 高级 → MCP 服务」为每个调用方签发，也可在服务器上：</p>
                <pre><code>{issue}</code></pre>
                <ul class="scopes">
                  {scopes.map((s) => <li><code>{s.name}</code><span>{s.can}</span>{s.needs && <small>需开启{s.needs}</small>}</li>)}
                </ul>
              </li>
              <li>
                <p><b>连接</b>　地址 <code>https://your.domain/mcp</code>，请求头 <code>Authorization: Bearer obi_client_…</code></p>
                <div class="clients">
                  {clients.map((c, i) => (
                    <details name="mcp-client" open={i === 0}>
                      <summary>{c.label}</summary>
                      <pre><code>{c.code}</code></pre>
                    </details>
                  ))}
                </div>
              </li>
            </ol>
          </section>

          {toolGroups.map((g) => (
            <section id={g.id} class="block" aria-labelledby={`${g.id}-t`}>
              <h3 id={`${g.id}-t`}>{g.title}<span class="count" aria-hidden="true">{g.tools.length}</span></h3>
              <div class="tools">{g.tools.map((t) => <ApiTool tool={t} />)}</div>
            </section>
          ))}

          <section id="mcp-prompts" class="block" aria-labelledby="mcp-prompts-t">
            <h3 id="mcp-prompts-t">场景模板<span class="count" aria-hidden="true">{prompts.length}</span></h3>
            <p class="sub">在客户端里选一个、填参数，Agent 就拿到整套步骤；发布、下单前都会先问你。</p>
            <ul class="prompts">
              {prompts.map((p) => <li><code>{p.name}</code><b>{p.title}</b><span>{p.args}</span><small>{p.scopes}</small></li>)}
            </ul>
          </section>

          <section id="mcp-protocol" class="block" aria-labelledby="mcp-protocol-t">
            <h3 id="mcp-protocol-t">协议细节</h3>
            <dl class="kv">{protocol.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}</dl>
          </section>
        </section>

        <section id="side-b" class="side" aria-labelledby="side-b-t">
          <header class="sh"><span class="disc" aria-hidden="true">B</span><div><h2 id="side-b-t">HTTP</h2><p>带 <span class="need-dot" aria-hidden="true"></span> 的字段必填。对外接口用令牌，应用接口用登录会话。</p></div></header>

          <section id="http-auth" class="block" aria-labelledby="http-auth-t">
            <h3 id="http-auth-t">鉴权与调用</h3>
            <dl class="kv">{conventions.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}</dl>
            <div class="pair">
              <figure><figcaption>令牌</figcaption><pre><code>{curl}</code></pre></figure>
              <figure><figcaption>会话</figcaption><pre><code>{login}</code></pre></figure>
            </div>
            <ul class="errors" aria-label="状态码">{errors.map((e) => <li><code>{e.k}</code><span>{e.v}</span></li>)}</ul>
          </section>

          <ApiGroup group={open} auth="令牌" />
          <p class="divider"><span>应用接口</span>网页应用自己用的路由；接口随版本调整，脚本优先用上面的对外接口。</p>
          {app.map((g) => <ApiGroup group={g} auth="会话" />)}
        </section>

        <p class="more">
          <a href={`${docs}/MCP接入.md`}>MCP 接入</a>
          <a href={`${docs}/HTTP接口一览.md`}>HTTP 接口一览</a>
          <a href={`${docs}/接口场景指南.md`}>场景指南</a>
          <a href={`${docs}/对外令牌.md`}>对外令牌</a>
          <a href={`${docs}/Agent上架接口.md`}>资料包与交易同步</a>
          <a href={`${docs}/采购评估接口.md`}>采购评估</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
  <script src="../scripts/api-toc.ts"></script>
</Base>


<style>
  .intro{ padding-block:var(--s-7) var(--s-6); }
  h1{ font-size:var(--fs-2xl); font-weight:800; letter-spacing:-.02em; }
  .lede{ margin-top:var(--s-3); max-width:36rem; color:var(--muted); }
  .sides{ display:flex; flex-wrap:wrap; gap:var(--s-2); margin-top:var(--s-5); }
  .sides a, .more a{ display:inline-flex; align-items:center; gap:var(--s-2); min-height:2.75rem; padding-inline:var(--s-3) var(--s-4); border-radius:999px; border:1px solid var(--border); font-size:var(--fs-sm); }
  .mark{ display:grid; place-items:center; width:1.5rem; height:1.5rem; border-radius:50%; background:var(--accent); color:var(--accent-ink); font-size:.7rem; font-weight:700; }

  .layout{ display:grid; grid-template-columns:minmax(0,1fr); gap:var(--s-5); padding-bottom:var(--s-8); }
  @media (min-width:64rem){ .layout{ grid-template-columns:14rem minmax(0,1fr); gap:var(--s-7); } }
  /* 窄屏多了一条吸顶目录：页内跳转的落点再往下让出它的高度 */
  @media (max-width:63.99rem){ :global(html){ scroll-padding-top:calc(6.75rem + env(safe-area-inset-top)); } }
  .content{ display:grid; gap:var(--s-8); min-width:0; }

  .side{ display:grid; gap:var(--s-7); }
  .sh{ display:flex; align-items:center; gap:var(--s-4); padding-bottom:var(--s-4); border-bottom:2px solid var(--text); }
  /* 面标记：一张唱片——外圈是盘，中间是写着 A / B 的标签 */
  .disc{ flex:none; display:grid; place-items:center; width:3.5rem; height:3.5rem; border-radius:50%;
    background:radial-gradient(circle, var(--accent) 0 38%, var(--vinyl-body) 39% 100%); color:var(--accent-ink); font-weight:800; font-size:var(--fs-md);
    box-shadow:inset 0 0 0 1px var(--vinyl-rim); }
  .sh h2{ font-size:var(--fs-xl); font-weight:800; letter-spacing:-.01em; }
  .sh p{ margin-top:var(--s-1); color:var(--muted); font-size:var(--fs-sm); }
  .need-dot{ display:inline-block; width:.35rem; height:.35rem; vertical-align:.2em; border-radius:50%; background:var(--accent-deep); }

  .block{ display:grid; gap:var(--s-3); }
  .block h3{ display:flex; align-items:baseline; gap:var(--s-2); font-size:var(--fs-lg); font-weight:700; }
  .count{ font-size:var(--fs-xs); font-weight:400; font-variant-numeric:tabular-nums; color:var(--muted); }
  .sub{ color:var(--muted); font-size:var(--fs-sm); }
  code{ font-size:.92em; overflow-wrap:anywhere; }
  pre{ margin:0; padding:var(--s-3) var(--s-4); overflow-x:auto; border-radius:var(--radius-sm); background:var(--surface-2); border:1px solid var(--hairline); font-size:var(--fs-xs); line-height:1.7; }
  pre code{ overflow-wrap:normal; }

  .steps{ display:grid; gap:var(--s-5); margin:0; padding:0; list-style:none; counter-reset:step; }
  .steps > li{ display:grid; grid-template-columns:minmax(0,1fr); gap:var(--s-3); padding-left:2.25rem; position:relative; counter-increment:step; min-width:0; }
  .steps > li::before{ content:counter(step); position:absolute; left:0; top:-.1rem; display:grid; place-items:center; width:1.5rem; height:1.5rem; border-radius:50%; border:2px solid var(--accent-deep); font-size:var(--fs-xs); font-weight:700; }
  .steps p{ font-size:var(--fs-sm); color:var(--muted); }
  .steps b{ color:var(--text); }
  .scopes{ display:grid; gap:var(--s-2); margin:0; padding:0; list-style:none; }
  @media (min-width:40rem){ .scopes{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
  .scopes li{ display:grid; gap:2px; padding:var(--s-3); border-radius:var(--radius-sm); background:var(--surface); border:1px solid var(--border); font-size:var(--fs-sm); }
  .scopes code{ font-weight:700; }
  small{ color:var(--muted); font-size:var(--fs-xs); }
  .clients{ display:grid; grid-template-columns:minmax(0,1fr); border-radius:var(--radius-sm); border:1px solid var(--border); background:var(--surface); }
  .clients details + details{ border-top:1px solid var(--hairline); }
  .clients summary{ display:flex; align-items:center; min-height:2.75rem; padding-inline:var(--s-3); cursor:pointer; font-size:var(--fs-sm); font-weight:600; }
  .clients details[open] summary{ color:var(--accent-text); }
  .clients pre{ margin:0 var(--s-3) var(--s-3); }

  .tools{ display:grid; gap:var(--s-3); grid-template-columns:minmax(0,1fr); }
  .prompts, .errors{ display:grid; gap:var(--s-2); margin:0; padding:0; list-style:none; }
  .prompts li{ display:grid; grid-template-columns:minmax(0,1fr); gap:2px; padding:var(--s-3) var(--s-4); border-radius:var(--radius-sm); background:var(--surface); border:1px solid var(--border); font-size:var(--fs-sm); }
  .prompts code{ font-weight:700; }
  .prompts span{ color:var(--muted); }
  .kv{ display:grid; margin:0; border-top:1px solid var(--hairline); font-size:var(--fs-sm); }
  .kv div{ display:grid; grid-template-columns:3rem minmax(0,1fr); gap:var(--s-3); padding-block:var(--s-2); border-bottom:1px solid var(--hairline); }
  dt{ font-weight:600; }
  dd{ margin:0; color:var(--muted); min-width:0; overflow-wrap:anywhere; }
  .pair{ display:grid; gap:var(--s-3); grid-template-columns:minmax(0,1fr); }
  @media (min-width:48rem){ .pair{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
  figure{ margin:0; display:grid; gap:var(--s-1); min-width:0; }
  figcaption{ font-size:var(--fs-xs); color:var(--muted); }
  .errors{ grid-template-columns:repeat(auto-fill,minmax(min(100%,13rem),1fr)); }
  .errors li{ display:flex; gap:var(--s-2); align-items:baseline; font-size:var(--fs-xs); color:var(--muted); }
  .errors code{ font-weight:700; color:var(--text); font-size:var(--fs-sm); }

  .divider{ display:grid; gap:var(--s-1); padding-top:var(--s-5); border-top:1px dashed var(--border-strong); color:var(--muted); font-size:var(--fs-sm); }
  .divider span{ color:var(--text); font-size:var(--fs-lg); font-weight:800; }
  .more{ display:flex; flex-wrap:wrap; gap:var(--s-2); }
  @media (hover:hover){ .sides a:hover, .more a:hover{ background:var(--surface-2); } .clients summary:hover{ color:var(--text); } }
</style>
